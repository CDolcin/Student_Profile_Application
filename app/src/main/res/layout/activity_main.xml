<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:fillViewport="true"
    android:overScrollMode="always">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <RelativeLayout
            android:id="@+id/profileHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2F5FD1"
            android:elevation="4dp"
            android:padding="14dp">

            <!-- APP TITLE -->

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_profile"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- APP SUBTITLE -->

            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/appTitle"
                android:layout_marginTop="4dp"
                android:text="@string/academic_profile"
                android:textColor="#E2E9FC"
                android:textSize="15sp" />

            <!-- ================================================= -->
            <!-- PROFILE ROW -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/profileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/appSubtitle"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- PROFILE PICTURE -->

                <RelativeLayout
                    android:id="@+id/imageFrame"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="#E9EEFB"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/imgProfilePicture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_picture"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/cdolcin" />

                </RelativeLayout>

                <!-- GREETING -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hello_everyone"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/greetingSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/welcome_profile"
                        android:textColor="#E2E9FC"
                        android:textSize="17sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ADD PICTURE BUTTON -->

            <Button
                android:id="@+id/btnAddPicture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/profileRow"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:text="@string/add_picture"
                android:textAllCaps="false" />

        </RelativeLayout>


        <!-- ===================================================== -->
        <!-- DETAILS CARD -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/detailsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECTION TITLE -->

            <TextView
                android:id="@+id/sectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_academic_details"
                android:textColor="#2F5FD1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- DIVIDER -->

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="#E0E4EC" />


            <!-- ================================================= -->
            <!-- FULL NAME -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/full_name"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/student_name_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- STUDENT ID -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/student_id"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/student_id_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- PROGRAMME -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/programme"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/programme_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- SEMESTER -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblSemester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/semester"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSemester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/semester_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- DEPARTMENT -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/department"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/department_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_address"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/email_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- PHONE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/lblPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_number"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                android:background="#F5F7FB"
                android:padding="10dp"
                android:text="@string/phone_value"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- EDIT / SAVE / CLEAR BUTTONS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/actionButtons"
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- EDIT -->

                <Button
                    android:id="@+id/btnEdit"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2F5FD1"
                    android:minHeight="44dp"
                    android:text="@string/edit"
                    android:textColor="#FFFFFF" />

                <!-- SAVE -->

                <Button
                    android:id="@+id/btnSave"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2F5FD1"
                    android:minHeight="44dp"
                    android:text="@string/save"
                    android:textColor="#FFFFFF" />

                <!-- CLEAR -->

                <Button
                    android:id="@+id/btnClear"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E0E4EC"
                    android:minHeight="44dp"
                    android:text="@string/clear"
                    android:textColor="#222222" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>